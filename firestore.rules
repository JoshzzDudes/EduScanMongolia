rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // administrators: a document admins/{uid}, created by hand in the Firebase console
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // each signed-in teacher reads and writes only their own records: users/{uid}/{kind}/{id}
    // (classes, students, exams, results); nobody else, the administrator included, can read them
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // account profile shown to the administrator: name, e-mail, school, dates, counts,
    // and anonymous figures per exam (number of sheets, mean, levels; never students' names or individual results)
    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'school', 'provider', 'verified', 'created', 'seen', 'counts', 'ver', 'stats'])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.get('stats', null) == null || (request.resource.data.stats is list && request.resource.data.stats.size() <= 40));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // a teacher may check whether they are an administrator; nobody can make themselves one
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }
  }
}
